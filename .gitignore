# Credentials. Never commit.
.env

__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
baselines/.lock
baselines/.*.backup/
baselines/.*-*/
.coverage
dist/

# Records the package index used on the machine that generated it; regenerate against public PyPI before sharing.
uv.lock

# Built Chips, Cases and Run outputs; commit curated ones under fixtures/ instead.
data/
runs/
batches/
# Except the demo pack (demo/stories.toml), which is laid out like a local store.
!demo/pack/data/
!demo/pack/batches/
!demo/pack/batches/*/runs/
demo/pack/baselines/.lock

# CDK output, and lookups that record the account ID.
infra/cdk.out/
infra/cdk.context.json
infra/node_modules/
